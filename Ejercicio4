<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Sitio Educativo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="Ejercicio2y3_css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand" href="#">Mi Academia</a>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse" data-bs-target="#menuNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="#">Inicio</a></li>
        <li class="nav-item"><a class="nav-link" href="#cursos">Cursos</a></li>
        <li class="nav-item"><a class="nav-link" href="#noticias">Noticias</a></li>
      </ul>
      <div class="d-flex flex-column flex-lg-row gap-2 mt-3 mt-lg-0">
        <button class="btn btn-outline-light">Iniciar Sesión</button>
        <button class="btn btn-warning">Registrarse</button>
      </div>
    </div>
  </div>
</nav>
<section class="hero">
  <div class="hero-texto">
    <h1>Aprende sin límites</h1>
    <p>Descubre cursos que impulsarán tu carrera profesional.</p>
    <button class="btn btn-primary">Ver cursos</button>
  </div>
  <div class="hero-imagen">
    <img src="https://via.placeholder.com/500x350" alt="Educación">
  </div>
</section>
<section id="cursos" class="cursos">
    <h2>Nuestros cursos</h2>
    <div class="grid-cursos">
        <div class="card-curso"><h3>Calculo</h3><p>Limites y derivadas</p></div>
        <div class="card-curso"><h3>Programacion</h3><p>HTML, CSS, JS</p></div>
        <div class="card-curso"><h3>Ingles</h3><p>B1,B2,B3,C1,C2</p></div>
        <div class="card-curso"><h3>Fisica</h3><p>Calorimetria y electricidad</p></div>
        <div class="card-curso"><h3>Realidad nacional</h3><p>Politica  y estado</p></div>
        <div class="card-curso"><h3>Algebra lineal</h3><p>Vectores y matrices</p></div>
    </div>
</section>
<section id="Noticias" class="bg-light py-5">
    <div class="container">
        <h2 class="mb-4 text-center">Noticias y eventos</h2>
        <div class="row g-4">
            <div class="clo-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Feria de ciencias</h5>
                        <p class="card-text">Proyectos estudiantiles</p>
                        <button class="btn btn-primary" data-bs-toggle="modal" 
                        data-bs-target="#modalNoticia">Mas informacion</button>
                    </div>
                </div>
            </div>
            <div class="clo-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Taller de robotica</h5>
                        <p class="card-text">Construye tu primer robot</p>
                        <button class="btn btn-primary" data-bs-toggle="modal" 
                        data-bs-target="#modalNoticia">Mas informacion</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" id="modalNoticia" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalles del evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Fecha 15 de junio</p>
                <p>Lugar: auditorio de ingenieria de sistemas</p>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
                        