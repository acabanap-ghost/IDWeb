// Arreglo global de tareas
let tareas = [
    { id: 1, titulo: "Estudiar JavaScript", curso: "Programación Web", fechaEntrega: "2025-12-01", completada: false },
    { id: 2, titulo: "Hacer tarea de CSS", curso: "Diseño Web", fechaEntrega: "2025-11-25", completada: true },
    { id: 3, titulo: "Practicar ES6", curso: "Programación Web", fechaEntrega: "2025-12-10", completada: false }
];
// MAP: obtener titulos
const titulos = tareas.map(t => t.titulo);
console.log("Titulos:", titulos);
// FILTER: pendientes y completadas
const pendientes = tareas.filter(t => !t.completada);
const completadas = tareas.filter(t => t.completada);
console.log("Pendientes:", pendientes.length, "Completadas:", completadas.length);
// REDUCE: contar total y completadas
const total = tareas.reduce(acc => acc + 1, 0);
const totalCompletadas = tareas.reduce((acc, t) => t.completada ? acc + 1 : acc, 0);
console.log("Total:", total, "Completadas:", totalCompletadas);
// FIND: buscar por id
const encontrada = tareas.find(t => t.id === 2);
console.log("Tarea id 2:", encontrada);
function agregarTarea(titulo, curso, fechaEntrega) {
    tareas.push({ id: Date.now(), titulo, curso, fechaEntrega, completada: false });
}
agregarTarea("Repasar Arrays", "Programación Web", "2025-12-15");
// Alternar estado
function alternarEstado(id) {
    const t = tareas.find(t => t.id === id);
    if (t) t.completada = !t.completada;
}
alternarEstado(1);
// Eliminar tarea
function eliminarTarea(id) {
    tareas = tareas.filter(t => t.id !== id);
}
eliminarTarea(3);
console.log("Tareas finales:", tareas);
